    "/api/enquiries": {
      "post": {
        "summary": "Submit Service Enquiry (Resident)",
        "tags": [
          "Service Enquiries"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "vendor_id": 1495,
                "name": "Rohan Sharma",
                "phone": "9876543210",
                "service_type": "Pipe Leakage Repair",
                "preferred_time": "Today 5:00 PM",
                "description": "Major leak in kitchen sink pipe under the counter",
                "society_name": "Silver Oak Heights",
                "sector": "Sector 45"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Service enquiry submitted successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Service enquiry submitted successfully!",
                  "enquiry": {
                    "enquiry_id": 45,
                    "vendor_id": 1495,
                    "vendor_name": "FastPlumb Services",
                    "store_name": "FastPlumb Plumbers",
                    "user_name": "Rohan Sharma",
                    "user_phone": "9876543210",
                    "service_type": "Pipe Leakage Repair",
                    "preferred_time": "Today 5:00 PM",
                    "description": "Major leak in kitchen sink pipe under the counter",
                    "status": "NEW",
                    "created_at_readable": "03 Nov 2026, 06:15 pm IST",
                    "direct_actions": {
                      "whatsapp_link": "https://wa.me/919911223344?text=...",
                      "call_link": "tel:9911223344"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/vendors/{vendorId}/enquiries": {
      "get": {
        "summary": "Get Service Enquiries for Vendor",
        "tags": [
          "Service Enquiries"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "vendorId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "NEW",
                "IN_PROGRESS",
                "COMPLETED",
                "CANCELLED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Enquiries retrieved successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "total": 1,
                  "enquiries": [
                    {
                      "enquiry_id": 45,
                      "vendor_id": 1495,
                      "user_name": "Rohan Sharma",
                      "user_phone": "9876543210",
                      "service_type": "Pipe Leakage Repair",
                      "preferred_time": "Today 5:00 PM",
                      "status": "NEW",
                      "created_at_readable": "03 Nov 2026, 06:15 pm IST"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/vendors/{vendorId}/enquiries/{enquiryId}/status": {
      "patch": {
        "summary": "Update Enquiry Status (Vendor)",
        "tags": [
          "Service Enquiries"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "vendorId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "enquiryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "status": "IN_PROGRESS"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Enquiry status updated to \"IN_PROGRESS\"",
                  "enquiry_id": 45,
                  "status": "IN_PROGRESS"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter JWT Access Token"
      }
    },
    "schemas": {
      "VendorRegisterRequest": {
        "type": "object",
        "required": [
          "society_id",
          "vendor_name",
          "email",
          "password",
          "store_name"
        ],
        "properties": {
          "society_id": {
            "type": "integer"
          },
          "vendor_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          },
          "store_name": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          },
          "gst_number": {
            "type": "string"
          }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": [
          "customer_name",
          "phone_number",
          "address",
          "vendor_id",
          "items"
        ],
        "properties": {
          "customer_name": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "vendor_id": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "quantity"
              ],
              "properties": {
                "item_id": {
                  "type": "integer"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "400Error": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "example": {
              "error": "Validation Error: Invalid email address format",
              "details": [
                {
                  "field": "email",
                  "message": "Invalid email address format"
                }
              ]
            }
          }
        }
      },
      "401Error": {
        "description": "Unauthorized Access",
        "content": {
          "application/json": {
            "example": {
              "error": "Unauthorized: Access token is missing or invalid"
            }
          }
        }
      },
      "403Error": {
        "description": "Forbidden Access / IDOR Guard Violation",
        "content": {
          "application/json": {
            "example": {
              "error": "Forbidden: You do not have permission to access this vendor resource"
            }
          }
        }
      }
    }
  }
}