{
  "openapi": "3.1.0",
  "info": {
    "title": "DigiLocal Backend API Platform",
    "description": "Production-grade RESTful API specification for DigiLocal local marketplace, vendor subscriptions, customer ordering, and admin management.",
    "version": "1.0.0",
    "contact": {
      "name": "DigiLocal Platform Engineering",
      "email": "support@digilocal.in"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/vendors/register": {
      "post": {
        "summary": "Vendor Registration & Payment Submission",
        "tags": ["Vendor Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VendorRegisterRequest" },
              "example": {
                "society_id": 1,
                "vendor_name": "Rajesh Sharma",
                "email": "freshmart@gmail.com",
                "password": "vendorPassword123",
                "store_name": "FreshMart Grocery & Organic",
                "phone_number": "9876543210",
                "gst_number": "07AAACR12341Z5"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vendor registered successfully",
            "content": {
              "application/json": {
                "example": {
                  "message": "Vendor registration & payment submitted successfully!",
                  "vendor_id": 1,
                  "vendor": {
                    "vendor_id": 1,
                    "society_id": 1,
                    "vendor_name": "Rajesh Sharma",
                    "store_name": "FreshMart Grocery & Organic",
                    "email": "freshmart@gmail.com",
                    "status": "PENDING"
                  },
                  "status": "PENDING",
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400Error" }
        }
      }
    },
    "/api/vendors/login": {
      "post": {
        "summary": "Vendor Login",
        "tags": ["Vendor Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              },
              "example": {
                "email": "freshmart@gmail.com",
                "password": "vendor123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": {
                  "message": "Login successful",
                  "vendor": {
                    "vendor_id": 1,
                    "vendor_name": "Rajesh Sharma",
                    "store_name": "FreshMart Grocery & Organic",
                    "email": "freshmart@gmail.com",
                    "status": "ACTIVE"
                  },
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/401Error" },
          "429": { "description": "Too Many Requests / Account Lockout" }
        }
      }
    },
    "/api/societies": {
      "get": {
        "summary": "List All Societies",
        "tags": ["Storefront & Societies"],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Filter by society name, location, or store name",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of active societies",
            "content": {
              "application/json": {
                "example": [
                  {
                    "society_id": 1,
                    "society_name": "Greenwood Residency",
                    "location": "Block A, Sector 62, Noida",
                    "vendor_count": 2
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "post": {
        "summary": "Customer Places an Order",
        "tags": ["Customer Orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrderRequest" },
              "example": {
                "customer_name": "Rahul Verma",
                "phone_number": "9898989898",
                "address": "Flat 402, Tower B, Greenwood Residency",
                "vendor_id": 1,
                "items": [
                  { "item_id": 1, "quantity": 1, "unit_price": 68.00 },
                  { "item_id": 2, "quantity": 1, "unit_price": 240.00 }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created successfully",
            "content": {
              "application/json": {
                "example": {
                  "message": "Order placed successfully",
                  "order_id": 1,
                  "total_amount": 308.00,
                  "status": "PLACED"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400Error" }
        }
      }
    },
    "/api/vendorPanel/{vendorId}": {
      "get": {
        "summary": "Get Full Vendor Dashboard Data",
        "tags": ["Vendor Dashboard"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "vendorId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Vendor dashboard details",
            "content": {
              "application/json": {
                "example": {
                  "vendor": { "vendor_id": 1, "store_name": "FreshMart Grocery & Organic" },
                  "items": [],
                  "orders": [],
                  "subscription": { "status": "ACTIVE" },
                  "payments": []
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/403Error" }
        }
      }
    },
    "/api/admin/login": {
      "post": {
        "summary": "Admin Login (Super Admin & Sub-Admins)",
        "tags": ["Admin Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "admin@digilocal.com",
                "password": "Password123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Authentication successful.",
                  "data": {
                    "user": { "id": "usr-admin-01", "name": "Super Administrator", "role": "SUPER_ADMIN", "permissions": ["ALL"] },
                    "access_token": "eyJhbGciOiJIUzI1Ni...",
                    "refresh_token": "def456uvw789...",
                    "expires_in": 900
                  },
                  "timestamp": "2026-08-14T12:30:00.000Z",
                  "request_id": "req_99f2b801"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/societies": {
      "get": {
        "summary": "List All Societies with Status Filtering",
        "tags": ["Admin Societies"],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["all", "active", "suspended", "pending"] } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Societies list retrieved successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": [{ "society_id": 1, "society_name": "Greenwood Residency", "status": "active" }],
                  "pagination": { "total": 36, "page": 1, "limit": 20, "total_pages": 2, "has_next": true, "has_prev": false }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register New Society",
        "tags": ["Admin Societies"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "society_name": "Grand Sapphire Towers",
                "location": "Sector 128, Noida, UP",
                "secretary_name": "Vikramaditya Roy",
                "secretary_mobile": "9810012345",
                "pincode": "201304"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Society registered successfully" }
        }
      }
    },
    "/api/admin/vendors": {
      "get": {
        "summary": "List All Vendors with Status & Search Filtering",
        "tags": ["Admin Vendor Management"],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Vendors list retrieved successfully" }
        }
      }
    },
    "/api/admin/subscriptions/stats": {
      "get": {
        "summary": "Subscription Telemetry & MRR Summary",
        "tags": ["Admin Subscriptions"],
        "responses": {
          "200": {
            "description": "Telemetry stats retrieved",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "mrr": 58450.00,
                    "arr": 701400.00,
                    "active_subscriptions": 980,
                    "expiring_soon_15_days": 14,
                    "tier_breakdown": { "free": 120, "pro": 650, "enterprise": 210 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/payments/refund": {
      "post": {
        "summary": "Process Refund via Payment Gateway",
        "tags": ["Admin Payments & Revenue"],
        "parameters": [
          { "name": "X-Idempotency-Key", "in": "header", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "transaction_id": "TXN-9001", "amount": 450.00, "reason": "Damaged goods" }
            }
          }
        },
        "responses": {
          "200": { "description": "Refund processed successfully" }
        }
      }
    },
    "/api/admin/notifications/broadcast": {
      "post": {
        "summary": "Broadcast System Announcement to Vendors / Users",
        "tags": ["Admin Real-Time Notifications"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "title": "Platform Scheduled Maintenance",
                "message": "DigiLocal will undergo scheduled maintenance tonight 2 AM - 4 AM.",
                "target_audience": "ALL_VENDORS"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "System broadcast announcement dispatched successfully" }
        }
      }
    },
    "/api/admin/reports/telemetry": {
      "get": {
        "summary": "Executive Analytics Telemetry Metrics",
        "tags": ["Admin Executive Analytics"],
        "responses": {
          "200": { "description": "Executive telemetry metrics retrieved" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter JWT Access Token"
      }
    },
    "schemas": {
      "VendorRegisterRequest": {
        "type": "object",
        "required": ["society_id", "vendor_name", "email", "password", "store_name"],
        "properties": {
          "society_id": { "type": "integer" },
          "vendor_name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 },
          "store_name": { "type": "string" },
          "phone_number": { "type": "string" },
          "gst_number": { "type": "string" }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": ["customer_name", "phone_number", "address", "vendor_id", "items"],
        "properties": {
          "customer_name": { "type": "string" },
          "phone_number": { "type": "string" },
          "address": { "type": "string" },
          "vendor_id": { "type": "integer" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item_id", "quantity"],
              "properties": {
                "item_id": { "type": "integer" },
                "quantity": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "responses": {
      "400Error": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "example": {
              "error": "Validation Error: Invalid email address format",
              "details": [{ "field": "email", "message": "Invalid email address format" }]
            }
          }
        }
      },
      "401Error": {
        "description": "Unauthorized Access",
        "content": {
          "application/json": {
            "example": { "error": "Unauthorized: Access token is missing or invalid" }
          }
        }
      },
      "403Error": {
        "description": "Forbidden Access / IDOR Guard Violation",
        "content": {
          "application/json": {
            "example": { "error": "Forbidden: You do not have permission to access this vendor resource" }
          }
        }
      }
    }
  }
}
